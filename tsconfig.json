{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    // Atlas shares runtime-agnostic modules between the Deno edge function,
    // Node's test runner, and tsx scripts — all of which require explicit .ts
    // extensions on relative imports. Safe here because typecheck runs with
    // --noEmit (Metro/Babel does the actual bundling).
    "allowImportingTsExtensions": true,
    "paths": {
      "~/*": [
        "*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  // Edge functions are Deno programs (https: imports, Deno globals) — the RN
  // tsconfig can only ever report noise for them. Deno tooling checks them.
  // NOTE: setting "exclude" replaces tsc's default, so node_modules is listed.
  "exclude": [
    "node_modules",
    "supabase/functions"
  ]
}